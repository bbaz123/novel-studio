# Dependencies
node_modules/

# Local database & sensitive local data
# API keys are stored in novel.db — never upload local databases.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# Local database backups (full DB copies, same sensitivity as novel.db)
data/backup-*/

# OpenViking 本地同步队列状态（运行时生成，含待推送内容，不上传）
data/openviking-pending.jsonl

# 隔离测试运行产生的数据目录（可再生的数据库副本与日志）
.test-data-*/

# IDE / editor
.vs/
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo

# Logs / temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/

# OS
.DS_Store
Thumbs.db
desktop.ini

pnpm-lock.yaml
